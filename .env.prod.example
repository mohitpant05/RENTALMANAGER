# PostgreSQL
POSTGRES_USER=rentmanager
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=rentmanager

# Redis
REDIS_PASSWORD=CHANGE_ME_strong_password_here

# Meilisearch
MEILI_MASTER_KEY=CHANGE_ME_min_16_chars

# MinIO
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_password_here
# Public-facing URL for presigned URLs (browser-accessible endpoint)
MINIO_PUBLIC_ENDPOINT=https://storage.yourdomain.com

# Backend
SECRET_KEY=CHANGE_ME_min_32_chars_random_string
SUPERADMIN_SECRET_KEY=CHANGE_ME_min_32_chars_random_string
ALLOWED_SUPERADMIN_IPS=

# Frontend
NEXT_PUBLIC_API_URL=https://yourdomain.com/api

# TLS / Let's Encrypt
ACME_EMAIL=you@yourdomain.com
